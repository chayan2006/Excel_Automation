# Port for the web application
PORT=5050

# Strong random secret key for Flask session signing and CSRF tokens
# Generate one with: python3 -c 'import secrets; print(secrets.token_hex(32))'
EXCEL_AUTOMATION_SECRET=change_this_to_a_secure_random_key_in_production

# Gunicorn settings
GUNICORN_WORKERS=1
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
LOG_LEVEL=info


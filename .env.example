# Port for the web application
PORT=5050

# Strong random secret key for Flask session signing and CSRF tokens
# Generate one with: python3 -c 'import secrets; print(secrets.token_hex(32))'
EXCEL_AUTOMATION_SECRET=change_this_to_a_secure_random_key_in_production

# Website assistant (the "Ask a question" panel). It appears only when an Anthropic API key is set.
# Create a key at https://platform.claude.com and keep it out of version control.
ANTHROPIC_API_KEY=
# Optional: the Claude model and how much it thinks before answering (low, medium, high, xhigh or max)
ASSISTANT_MODEL=claude-opus-5-5
ASSISTANT_EFFORT=low

# Gunicorn settings
GUNICORN_WORKERS=1
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
LOG_LEVEL=info

